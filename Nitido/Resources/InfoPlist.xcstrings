    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nítido uses the camera to scan your documents. Images are processed on your iPhone and are never sent to any server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nítido usa la cámara para escanear tus documentos. Las imágenes se procesan en tu iPhone y no se envían a ningún servidor."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save scans you export as images to Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar en Fotos los escaneos que exportes como imagen."
          }
        }
      }
    }
  },
  "version": "1.0"
