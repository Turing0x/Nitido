    "pro.feature.pdfPassword.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a password on the PDF before sharing it. Anyone without it can't open the file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon una contraseña al PDF antes de compartirlo. Quien no la tenga no puede abrirlo."
