    "paywall.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidad"
          }
        }
      }
    },
    "paywall.renewalTerms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The yearly subscription renews by itself every year until you cancel it. If you start with the free trial, the first year is charged when the seven days end, unless you cancel before that. You can cancel whenever you want from iOS Settings, under your App Store account, and doing it at least 24 hours before the current period ends is enough. The lifetime purchase is a single payment and never renews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción anual se renueva sola cada año hasta que la canceles. Si empiezas con la prueba gratuita, se cobra el primer año al terminar los siete días, salvo que canceles antes. Puedes cancelar cuando quieras desde Ajustes de iOS, en tu cuenta de App Store, y basta con hacerlo al menos 24 horas antes de que acabe el periodo en curso. La compra de por vida es un pago único y no se renueva nunca."
          }
        }
      }
    },
    "paywall.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore purchases"
