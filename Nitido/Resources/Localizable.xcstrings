    "pro.feature.searchablePDF.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF carries the recognized text inside it, invisible and placed over the image. You can search and select it like a typed document, from your computer too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PDF lleva dentro el texto reconocido, invisible y colocado sobre la imagen. Se puede buscar y seleccionar como si fuera un documento escrito, también desde el ordenador."
